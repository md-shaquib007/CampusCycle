# Copy to db.properties for local use, or set neonDbUrl in the deployment environment.
# Never commit a real Neon URL or password.
neonDbUrl=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# Optional local fallback:
# dbUrl=jdbc:postgresql://localhost:5432/campuscycle?sslmode=disable
# dbUsername=postgres
# dbPassword=postgres

uploadPath=uploads
uploadMaxSize=5242880
collegeEmailDomains=*
