{
  "version": 2,
  "name": "campuscycle",
  "builds": [
    {
      "src": "src/main/webapp/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/src/main/webapp/css/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/src/main/webapp/index.html"
    }
  ]
}
